{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "bun install",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "routes": [
    { "src": "^/specimen/([^/.]+)\\.md$", "status": 308, "headers": { "Location": "/$1.md" } },
    { "src": "^/specimen/([^/.]+)/?$", "status": 308, "headers": { "Location": "/$1" } },
    {
      "src": "^/$",
      "headers": {
        "Vary": "Accept",
        "Link": "</index.md>; rel=\"alternate\"; type=\"text/markdown\", </llms.txt>; rel=\"describedby\"; type=\"text/plain\", </sitemap.xml>; rel=\"sitemap\"; type=\"application/xml\""
      },
      "continue": true
    },
    { "src": "^/$", "has": [{ "type": "header", "key": "accept", "value": ".*text/markdown.*" }], "dest": "/index.md" },
    { "src": "^/([^/.]+)/?$", "headers": { "Vary": "Accept" }, "continue": true },
    {
      "src": "^/([^/.]+)/?$",
      "has": [{ "type": "header", "key": "accept", "value": ".*text/markdown.*" }],
      "dest": "/$1.md"
    },
    { "handle": "filesystem" },
    { "handle": "error" },
    {
      "src": "^/.*$",
      "status": 404,
      "has": [{ "type": "header", "key": "accept", "value": ".*text/markdown.*" }],
      "dest": "/not-found.md",
      "headers": { "Vary": "Accept" }
    },
    { "src": "^/.*$", "status": 404, "dest": "/not-found.html", "headers": { "Vary": "Accept" } }
  ]
}
